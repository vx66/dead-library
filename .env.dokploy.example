# Pegar en Environment de Dokploy y completar los valores vacíos.
NODE_ENV=production
PORT=3000
DATA_DIR=/data
PUBLIC_ORIGIN=https://library.deadsmile.org

ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=

# Sustituir por la subred real de la red de Traefik, por ejemplo la salida de:
# docker network inspect dokploy-network --format '{{range .IPAM.Config}}{{println .Subnet}}{{end}}'
TRUST_PROXY=
