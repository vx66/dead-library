# Desarrollo local: copia este archivo a .env y completa ambas credenciales.
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000

# No hay administrador predeterminado. Al menos 12 caracteres en la contraseña.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Opcional: si se omite, se genera un secreto aleatorio persistente en DATA_DIR.
SESSION_SECRET=

# Para Node local, deja vacío para utilizar ./db. Docker utiliza /data.
DATA_DIR=
# Solo proxies que controlas. Vacío cuando usas Node sin proxy.
TRUST_PROXY=
